{
  "name": "hyeonse-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "node scripts/preview.mjs",
    "check": "next typegen && tsc --noEmit",
    "check:search": "node scripts/check-search.mjs",
    "check:lanyard": "node scripts/check-lanyard.mjs",
    "verify": "npm run check && npm run check:search && npm run check:lanyard && npm run build && npm run audit:content && npm run audit:design-system",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:design-system": "hds-audit ."
  },
  "dependencies": {
    "@hyeonse/design-system": "https://codeload.github.com/hyeonse-swing/hyeonse-design-system/tar.gz/d04bda5240e1c22bfc4dc165d8a34fa753ac3dd6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "axe-core": "^4.14.0",
    "lighthouse": "^13.5.0",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.3"
  }
}
