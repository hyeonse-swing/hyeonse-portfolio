{
  "name": "hyeonse-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/ensure-fonts.mjs && next build",
    "preview": "node scripts/preview.mjs",
    "check": "next typegen && tsc --noEmit",
    "check:search": "node scripts/check-search.mjs",
    "check:lanyard": "node scripts/check-lanyard.mjs",
    "verify": "npm run check && npm run check:search && npm run check:notes && npm run check:lanyard && npm run build && npm run audit:content && npm run audit:design-system",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:design-system": "hds-audit .",
    "check:notes": "node scripts/check-notes.mjs"
  },
  "dependencies": {
    "@giscus/react": "3.1.0",
    "@hyeonse/design-system": "https://codeload.github.com/hyeonse-swing/hyeonse-design-system/tar.gz/090e10e066b933c3c9565b4553c4c35ace45eb99",
    "gray-matter": "4.0.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "axe-core": "^4.14.0",
    "lighthouse": "^13.5.0",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.3"
  }
}
